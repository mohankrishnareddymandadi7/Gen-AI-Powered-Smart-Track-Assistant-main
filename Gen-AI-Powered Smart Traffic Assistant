const BACKEND_URL = "http://127.0.0.1:8000";

// ============================================================
// ANALYZE TRIP
// ============================================================

async function analyzeTrip() {
    const button = document.getElementById("analyzeButton");
    const loading = document.getElementById("loading");
    const results = document.getElementById("results");
    const errorBox = document.getElementById("error");

    if (!button || !loading || !results || !errorBox) {
        console.error("Required HTML elements are missing.");
        return;
    }

    errorBox.style.display = "none";
    loading.style.display = "block";
    button.disabled = true;

    const source = document.getElementById("source")?.value.trim() || "";
    const destination = document.getElementById("destination")?.value.trim() || "";
    const travelDate = document.getElementById("travelDate")?.value || "";
    const departureTime = document.getElementById("departureTime")?.value || "";

    const vehicles = Number(
        document.getElementById("vehicles")?.value || 0
    );

    const speed = Number(
        document.getElementById("speed")?.value || 0
    );

    const density =
        document.getElementById("density")?.value || "Low";

    const road =
        document.getElementById("road")?.value || "Dry";

    const weatherCity =
        document.getElementById("weatherCity")?.value.trim() || "";

    // Validation
    if (!source || !destination) {
        showError("Please enter source and destination.");
        resetButton();
        return;
    }

    if (!weatherCity) {
        showError("Please enter the weather city.");
        resetButton();
        return;
    }

    if (Number.isNaN(vehicles) || vehicles < 0) {
        showError("Please enter a valid vehicle count.");
        resetButton();
        return;
    }

    if (Number.isNaN(speed) || speed < 0) {
        showError("Please enter a valid average speed.");
        resetButton();
        return;
    }

    const userQuery =
        `I plan to travel from ${source} to ${destination} ` +
        `on ${travelDate || "the selected date"} ` +
        `at ${departureTime || "the selected time"}. ` +
        `Should I travel considering route, traffic, weather ` +
        `and road conditions? Give me a safe and practical recommendation.`;

    const requestData = {
        source: source,
        destination: destination,
        vehicles: vehicles,
        avg_speed: speed,
        density: density,
        road_condition: road,
        weather_city: weatherCity,
        user_query: userQuery
    };

    console.log("SMART TRAFFIC ASSISTANT REQUEST");
    console.log("Backend:", BACKEND_URL);
    console.log("Request:", requestData);

    try {
        const response = await fetch(
            BACKEND_URL + "/assistant",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify(requestData)
            }
        );

        const responseText = await response.text();

        console.log("HTTP Status:", response.status);
        console.log("Backend response:", responseText);

        let data = null;

        try {
            data = responseText
                ? JSON.parse(responseText)
                : null;
        } catch (jsonError) {
            throw new Error(
                "Backend returned invalid JSON:\n\n" +
                responseText
            );
        }

        if (!response.ok) {
            let message =
                `Backend returned HTTP ${response.status}`;

            if (data && data.detail) {
                message =
                    typeof data.detail === "string"
                        ? data.detail
                        : JSON.stringify(data.detail, null, 2);
            }

            throw new Error(message);
        }

        if (!data) {
            throw new Error(
                "Backend returned an empty response."
            );
        }

        displayResults(
            data,
            source,
            destination,
            travelDate,
            departureTime,
            vehicles,
            speed,
            density,
            road,
            weatherCity
        );

        results.style.display = "block";

        results.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });

        console.log(
            "Trip analysis completed successfully."
        );

    } catch (error) {
        console.error(
            "SMART TRAFFIC ASSISTANT ERROR:",
            error
        );

        let message =
            "Unable to complete the request.\n\n";

        if (
            error instanceof TypeError &&
            String(error.message)
                .toLowerCase()
                .includes("fetch")
        ) {
            message +=
                "The browser could not connect to FastAPI.\n\n" +
                "Make sure Terminal 1 is running the backend at:\n" +
                BACKEND_URL +
                "\n\nOpen:\n" +
                BACKEND_URL +
                "/docs";
        } else {
            message += error.message;
        }

        showError(message);

    } finally {
        resetButton();
    }
}


