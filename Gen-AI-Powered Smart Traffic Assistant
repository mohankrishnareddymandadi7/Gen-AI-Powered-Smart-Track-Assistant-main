<script>

const BACKEND_URL = "http://127.0.0.1:8000";


/* =========================================================
   ANALYZE TRIP
   ========================================================= */

async function analyzeTrip() {

    const button =
        document.getElementById("analyzeButton");

    const loading =
        document.getElementById("loading");

    const results =
        document.getElementById("results");

    const errorBox =
        document.getElementById("error");

    errorBox.style.display = "none";

    loading.style.display = "block";

    button.disabled = true;


    const source =
        document.getElementById("source").value.trim();

    const destination =
        document.getElementById("destination").value.trim();

    const travelDate =
        document.getElementById("travelDate").value;

    const departureTime =
        document.getElementById("departureTime").value;

    const vehicles =
        Number(
            document.getElementById("vehicles").value
        );

    const speed =
        Number(
            document.getElementById("speed").value
        );

    const density =
        document.getElementById("density").value;

    const road =
        document.getElementById("road").value;

    const weatherCity =
        document.getElementById("weatherCity").value.trim();


    if (!source || !destination) {

        showError(
            "Please enter source and destination."
        );

        resetButton();

        return;
    }


    if (!weatherCity) {

        showError(
            "Please enter the weather city."
        );

        resetButton();

        return;
    }


    if (
        Number.isNaN(vehicles) ||
        vehicles < 0
    ) {

        showError(
            "Please enter a valid vehicle count."
        );

        resetButton();

        return;
    }


    if (
        Number.isNaN(speed) ||
        speed < 0
    ) {

        showError(
            "Please enter a valid average speed."
        );

        resetButton();

        return;
    }


    const userQuery =
        `I plan to travel from ${source} to ${destination} ` +
        `on ${travelDate || "the selected date"} ` +
        `at ${departureTime || "the selected time"}. ` +
        `Should I travel considering route, traffic, weather ` +
        `and road conditions? Give me a safe and practical recommendation.`;


    const requestData = {

        source: source,

        destination: destination,

        vehicles: vehicles,

        avg_speed: speed,

        density: density,

        road_condition: road,

        weather_city: weatherCity,

        user_query: userQuery

    };


    console.log(
        "Sending request:",
        requestData
    );


    try {

        const response =
            await fetch(
                BACKEND_URL + "/assistant",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json",

                        "Accept":
                            "application/json"
                    },

                    body:
                        JSON.stringify(
                            requestData
                        )
                }
            );


        const responseText =
            await response.text();


        console.log(
            "HTTP Status:",
            response.status
        );


        console.log(
            "Backend response:",
            responseText
        );


        let data;


        try {

            data =
                responseText
                    ? JSON.parse(responseText)
                    : null;

        } catch (e) {

            throw new Error(
                "Backend returned invalid JSON."
            );
        }


        if (!response.ok) {

            let message =
                `Backend returned HTTP ${response.status}`;


            if (data && data.detail) {

                message =
                    typeof data.detail === "string"
                        ? data.detail
                        : JSON.stringify(
                            data.detail
                        );
            }


            throw new Error(message);
        }


        if (!data) {

            throw new Error(
                "Backend returned an empty response."
            );
        }


        displayResults(

            data,

            source,

            destination,

            travelDate,

            departureTime,

            vehicles,

            speed,

            density,

            road,

            weatherCity

        );


        results.style.display = "block";


        results.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });


    } catch (error) {

        console.error(error);


        showError(
            "❌ Unable to complete the request.\n\n" +
            error.message
        );

    } finally {

        resetButton();

    }

}


/* =========================================================
   DISPLAY RESULTS
   ========================================================= */

function displayResults(

    data,

    source,

    destination,

    travelDate,

    departureTime,

    vehicles,

    speed,

    density,

    road,

    weatherCity

) {

    document.getElementById(
        "tripRoute"
    ).innerText =
        `${source} → ${destination}`;


    document.getElementById(
        "tripTime"
    ).innerText =
        departureTime || "-";


    document.getElementById(
        "tripDate"
    ).innerText =
        travelDate || "-";


    /* ROUTE */

    const route =
        data.route || {};


    document.getElementById(
        "routeSource"
    ).innerText =
        route.source || source;


    document.getElementById(
        "routeDestination"
    ).innerText =
        route.destination || destination;


    const distance =
        Number(
            route.distance_km
        );


    document.getElementById(
        "routeDistance"
    ).innerText =
        Number.isFinite(distance)
            ? `${distance.toFixed(2)} km`
            : "Unavailable";


    if (
        route.duration_hours !== undefined &&
        route.duration_hours !== null
    ) {

        const hours =
            Number(
                route.duration_hours
            );


        document.getElementById(
            "routeDuration"
        ).innerText =
            Number.isFinite(hours)
                ? `${hours.toFixed(2)} hours`
                : "Unavailable";

    }

    else if (
        route.duration_minutes !== undefined &&
        route.duration_minutes !== null
    ) {

        document.getElementById(
            "routeDuration"
        ).innerText =
            `${route.duration_minutes} minutes`;

    }

    else {

        document.getElementById(
            "routeDuration"
        ).innerText =
            "Unavailable";
    }


    /* TRAFFIC */

    const traffic =
        data.traffic || {};


    const trafficStatus =
        document.getElementById(
            "trafficStatus"
        );


    const trafficLevel =
        String(
            traffic.level || "Unavailable"
        );


    trafficStatus.innerText =
        trafficLevel;


    trafficStatus.className =
        "status";


    const trafficLower =
        trafficLevel.toLowerCase();


    if (
        trafficLower.includes("high")
    ) {

        trafficStatus.classList.add(
            "high"
        );

    }

    else if (
        trafficLower.includes("medium")
    ) {

        trafficStatus.classList.add(
            "medium"
        );

    }

    else if (
        trafficLower.includes("low")
    ) {

        trafficStatus.classList.add(
            "low"
        );

    }

    else {

        trafficStatus.classList.add(
            "unavailable"
        );
    }


    document.getElementById(
        "trafficDetails"
    ).innerText =

        `Vehicles: ${traffic.vehicles ?? vehicles}\n` +

        `Average Speed: ${traffic.avg_speed ?? speed} km/h\n` +

        `Density: ${traffic.density ?? density}\n` +

        `Condition: ${traffic.condition ?? "Unavailable"}\n` +

        `Alert: ${traffic.alert ?? "No major alert"}`;


    /* WEATHER */

    const weather =
        data.weather || {};

    const routeWeather =
        data.route_weather || {};


    const sourceWeather =
        routeWeather.source || weather;


    const weatherStatus =
        document.getElementById(
            "weatherStatus"
        );


    const weatherCondition =
        String(
            sourceWeather.weather ||
            "Unavailable"
        );


    weatherStatus.innerText =
        weatherCondition;


    weatherStatus.className =
        "status";


    const weatherLower =
        weatherCondition.toLowerCase();


    if (
        weatherLower.includes("unavailable")
    ) {

        weatherStatus.classList.add(
            "unavailable"
        );

    }

    else if (
        weatherLower.includes("rain") ||
        weatherLower.includes("storm") ||
        weatherLower.includes("fog")
    ) {

        weatherStatus.classList.add(
            "medium"
        );

    }

    else {

        weatherStatus.classList.add(
            "low"
        );
    }


    document.getElementById(
        "weatherDetails"
    ).innerText =

        `Location: ${sourceWeather.city || weatherCity}\n` +

        `Description: ${sourceWeather.description || "Unavailable"}\n` +

        `Temperature: ${
            sourceWeather.temperature != null
                ? sourceWeather.temperature + " °C"
                : "Unavailable"
        }\n` +

        `Feels Like: ${
            sourceWeather.feels_like != null
                ? sourceWeather.feels_like + " °C"
                : "Unavailable"
        }\n` +

        `Humidity: ${
            sourceWeather.humidity != null
                ? sourceWeather.humidity + "%"
                : "Unavailable"
        }\n` +

        `Wind Speed: ${
            sourceWeather.wind_speed != null
                ? sourceWeather.wind_speed + " m/s"
                : "Unavailable"
        }`;


    /* DESTINATION WEATHER */

    const destinationWeather =
        routeWeather.destination || {};


    const destinationWeatherStatus =
        document.getElementById(
            "destinationWeatherStatus"
        );


    const destinationWeatherCondition =
        String(
            destinationWeather.weather ||
            "Unavailable"
        );


    destinationWeatherStatus.innerText =
        destinationWeatherCondition;


    destinationWeatherStatus.className =
        "status";


    const destinationWeatherLower =
        destinationWeatherCondition.toLowerCase();


    if (
        destinationWeatherLower.includes(
            "unavailable"
        )
    ) {

        destinationWeatherStatus.classList.add(
            "unavailable"
        );

    }

    else if (
        destinationWeatherLower.includes("rain") ||
        destinationWeatherLower.includes("storm") ||
        destinationWeatherLower.includes("fog")
    ) {

        destinationWeatherStatus.classList.add(
            "medium"
        );

    }

    else {

        destinationWeatherStatus.classList.add(
            "low"
        );
    }


    document.getElementById(
        "destinationWeatherDetails"
    ).innerText =

        `Location: ${
            destinationWeather.city ||
            destination ||
            "Unavailable"
        }\n` +

        `Description: ${
            destinationWeather.description ||
            "Unavailable"
        }\n` +

        `Temperature: ${
            destinationWeather.temperature != null
                ? destinationWeather.temperature + " °C"
                : "Unavailable"
        }\n` +

        `Feels Like: ${
            destinationWeather.feels_like != null
                ? destinationWeather.feels_like + " °C"
                : "Unavailable"
        }\n` +

        `Humidity: ${
            destinationWeather.humidity != null
                ? destinationWeather.humidity + "%"
                : "Unavailable"
        }\n` +

        `Wind Speed: ${
            destinationWeather.wind_speed != null
                ? destinationWeather.wind_speed + " m/s"
                : "Unavailable"
        }`;


    /* ROAD */

    const roadCondition =
        traffic.road_condition ||
        road ||
        "Unavailable";


    const roadStatus =
        document.getElementById(
            "roadStatus"
        );


    roadStatus.innerText =
        roadCondition;


    roadStatus.className =
        "status";


    const roadLower =
        roadCondition.toLowerCase();


    if (
        roadLower.includes("damaged") ||
        roadLower.includes("under construction")
    ) {

        roadStatus.classList.add(
            "high"
        );

    }

    else if (
        roadLower.includes("wet") ||
        roadLower.includes("damp")
    ) {

        roadStatus.classList.add(
            "medium"
        );

    }

    else if (
        roadLower.includes("unavailable")
    ) {

        roadStatus.classList.add(
            "unavailable"
        );

    }

    else {

        roadStatus.classList.add(
            "low"
        );
    }


    document.getElementById(
        "roadDetails"
    ).innerText =

        traffic.condition ||
        "Road condition information available.";


    /*
       IMPORTANT:
       This function now determines the
       GREEN / YELLOW / RED decision.
    */

    updateTravelDecision(
        traffic,
        roadCondition,
        weatherCondition
    );


    /* AI RECOMMENDATION */

    let recommendation =
        data.ai_recommendation ||
        data.recommendation ||
        "No AI recommendation returned.";


    document.getElementById(
        "recommendation"
    ).innerHTML =
        formatRecommendation(
            String(recommendation)
        );


    /* RAG */

    const ragContainer =
        document.getElementById(
            "ragKnowledge"
        );


    ragContainer.innerHTML = "";


    const rag =
        Array.isArray(
            data.rag_knowledge
        )
            ? data.rag_knowledge
            : [];


    if (
        rag.length === 0
    ) {

        ragContainer.innerText =
            "No relevant safety knowledge retrieved.";

    }

    else {

        rag.forEach(
            function(item) {

                const div =
                    document.createElement(
                        "div"
                    );

                div.className =
                    "rag-item";

                div.innerText =
                    String(item);

                ragContainer.appendChild(
                    div
                );
            }
        );
    }

}


/* =========================================================
   TRAVEL DECISION
   ========================================================= */

function updateTravelDecision(
    traffic,
    roadCondition,
    weatherCondition
) {

    const card =
        document.getElementById(
            "travelDecisionCard"
        );

    const status =
        document.getElementById(
            "decisionStatus"
        );

    const title =
        document.getElementById(
            "decisionTitle"
        );

    const reason =
        document.getElementById(
            "decisionReason"
        );


    /*
       Normalize values.
    */

    const trafficLevel =
        String(
            traffic.level || ""
        )
        .trim()
        .toLowerCase();


    const road =
        String(
            roadCondition || ""
        )
        .trim()
        .toLowerCase();


    const weather =
        String(
            weatherCondition || ""
        )
        .trim()
        .toLowerCase();


    /*
       Traffic conditions
    */

    const highTraffic =
        trafficLevel === "high";


    const mediumTraffic =
        trafficLevel === "medium";


    const lowTraffic =
        trafficLevel === "low";


    /*
       Road conditions
    */

    const badRoad =
        road.includes("damaged") ||
        road.includes("under construction");


    const wetRoad =
        road.includes("wet") ||
        road.includes("damp");


    /*
       Weather conditions
    */

    const badWeather =
        weather.includes("rain") ||
        weather.includes("storm") ||
        weather.includes("fog") ||
        weather.includes("snow");


    /*
    ==========================================================
       CASE 1 — SAFE
    ==========================================================
    */

    if (
        lowTraffic &&
        !badRoad &&
        !wetRoad &&
        !badWeather
    ) {

        card.className =
            "decision-card recommended";


        status.className =
            "decision-status green";


        status.innerText =
            "🟢 TRAVEL RECOMMENDED";


        title.innerText =
            "Current conditions are favorable";


        reason.innerText =
            "Traffic is low and the available road and weather " +
            "conditions do not indicate a major travel risk. " +
            "Normal safe-driving practices are recommended.";


        return;
    }


    /*
    ==========================================================
       CASE 3 — DANGEROUS
    ==========================================================
    */

    if (
        badRoad ||
        (
            highTraffic &&
            (
                wetRoad ||
                badWeather
            )
        )
    ) {

        card.className =
            "decision-card not-recommended";


        status.className =
            "decision-status red";


        status.innerText =
            "🔴 TRAVEL NOT RECOMMENDED";


        title.innerText =
            "Current conditions are unfavorable";


        if (badRoad) {

            reason.innerText =
                "The road condition is unsafe. " +
                "Consider delaying your journey or using " +
                "an alternative route.";

        }

        else {

            reason.innerText =
                "High traffic congestion is combined with " +
                "unfavorable road or weather conditions. " +
                "Consider delaying your journey.";
        }


        return;
    }


    /*
    ==========================================================
       CASE 2 — MODERATE
    ==========================================================
    */

    card.className =
        "decision-card caution";


    status.className =
        "decision-status yellow";


    status.innerText =
        "🟡 TRAVEL WITH CAUTION";


    title.innerText =
        "Travel is possible with additional caution";


    reason.innerText =
        "Current conditions show elevated travel risk. " +
        "Allow additional time, maintain a safe following " +
        "distance and drive carefully.";

}


/* =========================================================
   FORMAT AI RECOMMENDATION
   ========================================================= */

function formatRecommendation(text) {

    let html =
        escapeHTML(text);


    /*
       Headings
    */

    html =
        html.replace(
            /^###\s+(.+)$/gm,
            "<h3>$1</h3>"
        );


    html =
        html.replace(
            /^##\s+(.+)$/gm,
            "<h3>$1</h3>"
        );


    html =
        html.replace(
            /^#\s+(.+)$/gm,
            "<h3>$1</h3>"
        );


    /*
       Bold
    */

    html =
        html.replace(
            /\*\*(.*?)\*\*/g,
            "<strong>$1</strong>"
        );


    /*
       Italic
    */

    html =
        html.replace(
            /(?<!\*)\*([^*\n]+)\*(?!\*)/g,
            "<em>$1</em>"
        );


    /*
       Bullet points
    */

    html =
        html.replace(
            /^\s*[-*]\s+(.+)$/gm,
            "<li>$1</li>"
        );


    /*
       Numbered points
    */

    html =
        html.replace(
            /^\s*\d+\.\s+(.+)$/gm,
            "<li>$1</li>"
        );


    /*
       Convert consecutive li elements into ul.
    */

    html =
        html.replace(
            /((?:<li>.*?<\/li>\s*)+)/gs,
            "<ul>$1</ul>"
        );


    /*
       Line breaks
    */

    html =
        html.replace(
            /\n{2,}/g,
            "<br><br>"
        );


    html =
        html.replace(
            /\n/g,
            "<br>"
        );


    return html;
}


/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHTML(text) {

    return String(text)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );
}


/* =========================================================
