import os
import requests
from dotenv import load_dotenv

load_dotenv(override=True)

API_KEY = os.getenv("OPENWEATHER_API_KEY")

WEATHER_URL = "https://api.openweathermap.org/data/2.5/weather"


def _fallback_weather(city: str) -> dict:
    """Return safe fallback weather data."""

    return {
        "city": city,
        "temperature": None,
        "feels_like": None,
        "humidity": None,
        "weather": "Unavailable",
        "description": "Live weather data is temporarily unavailable.",
        "wind_speed": None,
        "source": "Fallback"
    }


def get_weather(city: str) -> dict:
    """
    Get current weather information for a city
    using OpenWeatherMap.
    """

    if not city or not city.strip():
        raise ValueError("City name cannot be empty.")

    city = city.strip()

    # Reload environment variables
    load_dotenv(override=True)

    api_key = os.getenv("OPENWEATHER_API_KEY")

    if not api_key or api_key == "YOUR_WEATHER_KEY":
        print("OpenWeather API key is missing.")
        return _fallback_weather(city)

    params = {
        "q": city,
        "appid": api_key,
        "units": "metric"
    }

    try:

        response = requests.get(
            WEATHER_URL,
            params=params,
            timeout=10
        )

        if response.status_code != 200:

            print(
                f"Weather API unavailable for {city}: "
                f"{response.status_code}"
            )

            return _fallback_weather(city)

        data = response.json()

        return {
            "city": data["name"],
            "temperature": data["main"]["temp"],
            "feels_like": data["main"]["feels_like"],
            "humidity": data["main"]["humidity"],
            "weather": data["weather"][0]["main"],
            "description": data["weather"][0]["description"],
            "wind_speed": data["wind"]["speed"],
            "source": "OpenWeather"
        }

    except requests.RequestException as e:

        print(f"Weather request failed for {city}: {e}")

        return _fallback_weather(city)

    except (KeyError, TypeError, ValueError) as e:

        print(f"Invalid weather response for {city}: {e}")

        return _fallback_weather(city)


def get_route_weather(
    source: str,
    destination: str
) -> dict:
    """
    Get weather for both the source and destination cities.
    """

    source_weather = get_weather(source)

    destination_weather = get_weather(destination)

    return {
        "source": source_weather,
        "destination": destination_weather
    }


