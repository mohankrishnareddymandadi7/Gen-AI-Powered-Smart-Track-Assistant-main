function updateTravelDecision(
    traffic,
    roadCondition,
    weatherCondition
) {

    const card =
        document.getElementById(
            "travelDecisionCard"
        );

    const status =
        document.getElementById(
            "decisionStatus"
        );

    const title =
        document.getElementById(
            "decisionTitle"
        );

    const reason =
        document.getElementById(
            "decisionReason"
        );

    if (!card || !status || !title || !reason) {
        console.warn(
            "Travel decision HTML elements are missing."
        );
        return;
    }

    const trafficLevel =
        String(
            traffic.level || ""
        ).toLowerCase();

    const road =
        String(
            roadCondition || ""
        ).toLowerCase();

    const weather =
        String(
            weatherCondition || ""
        ).toLowerCase();

    const highTraffic =
        trafficLevel.includes("high");

    const mediumTraffic =
        trafficLevel.includes("medium");

    const badRoad =
        road.includes("damaged");

    const wetRoad =
        road.includes("wet");

    const badWeather =
        weather.includes("rain") ||
        weather.includes("storm") ||
        weather.includes("fog");


    // NOT RECOMMENDED

    if (
        badRoad ||
        (
            highTraffic &&
            (
                wetRoad ||
                badWeather
            )
        )
    ) {

        card.className =
            "decision-card not-recommended";

        status.className =
            "decision-status red";

        status.innerText =
            "TRAVEL NOT RECOMMENDED";

        title.innerText =
            "Current conditions are unfavorable";

        if (badRoad) {

            reason.innerText =
                "The road is reported as damaged. " +
                "Avoid unsafe road sections and " +
                "consider an alternative route.";

        } else {

            reason.innerText =
                "High traffic congestion is combined " +
                "with unfavorable road or weather " +
                "conditions. Consider delaying your journey.";
        }

        return;
    }


    // CAUTION

    if (
        highTraffic ||
        mediumTraffic ||
        wetRoad ||
        badWeather
    ) {

        card.className =
            "decision-card caution";

        status.className =
            "decision-status yellow";

        status.innerText =
            "TRAVEL WITH CAUTION";

        title.innerText =
            "Travel is possible with additional caution";

        reason.innerText =
            "Current conditions show elevated travel risk. " +
            "Allow additional time, maintain a safe following " +
            "distance and drive carefully.";

        return;
    }


    // RECOMMENDED

    card.className =
        "decision-card recommended";

    status.className =
        "decision-status green";

    status.innerText =
        "TRAVEL RECOMMENDED";

    title.innerText =
        "Current conditions are favorable";

    reason.innerText =
        "The available traffic, road and weather information " +
        "does not indicate a major travel restriction. " +
        "Normal safe-driving practices are recommended.";
}


// ============================================================
