"""
route.py

Gets route information using OpenRouteService.
"""

import os
import openrouteservice
from dotenv import load_dotenv

load_dotenv(override=True)

API_KEY = os.getenv("OPENROUTE_API_KEY")

if not API_KEY:
    raise ValueError(
        "OPENROUTE_API_KEY not found. Check your .env file."
    )


def get_route(source: str, destination: str) -> dict:

    if not source or not source.strip():
        raise ValueError("Source cannot be empty.")

    if not destination or not destination.strip():
        raise ValueError("Destination cannot be empty.")

    client = openrouteservice.Client(key=API_KEY)

    # Search specifically within India
    source_result = client.pelias_search(
        text=source,
        country="IND"
    )

    destination_result = client.pelias_search(
        text=destination,
        country="IND"
    )

    if not source_result["features"]:
        raise RuntimeError(
            f"Could not find source: {source}"
        )

    if not destination_result["features"]:
        raise RuntimeError(
            f"Could not find destination: {destination}"
        )

    source_coords = (
        source_result["features"][0]
        ["geometry"]["coordinates"]
    )

    destination_coords = (
        destination_result["features"][0]
        ["geometry"]["coordinates"]
    )

    print("Source coordinates:", source_coords)
    print("Destination coordinates:", destination_coords)

    # Driving route
    route = client.directions(
        coordinates=[
            source_coords,
            destination_coords
        ],
        profile="driving-car",
        format="geojson"
    )

    summary = route["features"][0]["properties"]["summary"]

    distance_km = summary["distance"] / 1000
    duration_minutes = summary["duration"] / 60

    return {
        "source": source,
        "destination": destination,
        "distance_km": round(distance_km, 2),
        "duration_minutes": round(duration_minutes, 1),
        "duration_hours": round(
