"""
rag.py

Builds a small vector knowledge base from the knowledge_base/ text files
and retrieves the most relevant chunks for a given user question.
"""

import os
import glob
import chromadb

# Persistent local vector database (saved to disk in chroma_db/ folder)
chroma_client = chromadb.PersistentClient(path="chroma_db")

# A "collection" is like a table in the vector database
collection = chroma_client.get_or_create_collection(name="traffic_knowledge")


def load_knowledge_base(folder_path: str = "knowledge_base") -> list[dict]:
    """
    Read all .txt files in the knowledge_base folder and split them
    into individual chunks (one chunk per line).
    """
    chunks = []
    txt_files = glob.glob(os.path.join(folder_path, "*.txt"))

    if not txt_files:
        raise FileNotFoundError(f"No .txt files found in {folder_path}")

    for file_path in txt_files:
        file_name = os.path.basename(file_path)
        with open(file_path, "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f.readlines() if line.strip()]
            for i, line in enumerate(lines):
                chunks.append({
                    "id": f"{file_name}_{i}",
                    "text": line,
                    "source": file_name,
                })
    return chunks


def build_vector_store():
    """
    Embed all knowledge base chunks and store them in ChromaDB.
    Only needs to run once (or when knowledge base content changes).
    """
    chunks = load_knowledge_base()

    # ChromaDB automatically handles embedding using its default model
    collection.upsert(
        ids=[c["id"] for c in chunks],
        documents=[c["text"] for c in chunks],
        metadatas=[{"source": c["source"]} for c in chunks],
    )
    print(f"Vector store built with {len(chunks)} chunks.")


def retrieve_relevant_chunks(query: str, top_k: int = 3) -> list[str]:
    """
    Given a user question, return the top_k most relevant knowledge
    base chunks.
    """
    if not query or not query.strip():
        raise ValueError("Query cannot be empty.")

    results = collection.query(
        query_texts=[query],
        n_results=top_k,
    )

    documents = results.get("documents", [[]])[0]
    return documents


if __name__ == "__main__":
    # First run: build the vector store
    build_vector_store()

    # Then test retrieval
    test_query = "What should be done during an accident?"
    relevant = retrieve_relevant_chunks(test_query)

    print(f"\nQuery: {test_query}")
    print("Top relevant chunks:")
    for chunk in relevant:
        print("-", chunk)

