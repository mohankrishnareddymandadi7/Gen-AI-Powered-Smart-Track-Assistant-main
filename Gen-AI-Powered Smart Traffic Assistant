// ============================================================

function formatRecommendation(text) {

    let html =
        escapeHTML(text);

    // Headings
    html = html.replace(
        /^###\s+(.+)$/gm,
        "<h3>$1</h3>"
    );

    html = html.replace(
        /^##\s+(.+)$/gm,
        "<h3>$1</h3>"
    );

    html = html.replace(
        /^#\s+(.+)$/gm,
        "<h3>$1</h3>"
    );

    // Bold
    html = html.replace(
        /\*\*(.*?)\*\*/g,
        "<strong>$1</strong>"
    );

    // Italic
    html = html.replace(
        /(?<!\*)\*([^*\n]+)\*(?!\*)/g,
        "<em>$1</em>"
    );

    // Bullet points
    html = html.replace(
        /^\s*[-*]\s+(.+)$/gm,
        "<li>$1</li>"
    );

    // Numbered points
    html = html.replace(
        /^\s*\d+\.\s+(.+)$/gm,
        "<li>$1</li>"
    );

    // Wrap lists
    html = html.replace(
        /((?:<li>.*?<\/li>\s*)+)/gs,
        "<ul>$1</ul>"
    );

    // Paragraph spacing
    html = html.replace(
        /\n{2,}/g,
        "<br><br>"
    );

    // Single line breaks
    html = html.replace(
        /\n/g,
        "<br>"
    );

    return html;
}


