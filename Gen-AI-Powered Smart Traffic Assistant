"""
traffic_analysis.py

Rule-based traffic analysis for the
GenAI-Powered Smart Traffic Assistant.
"""

import pandas as pd


def analyze_traffic(
    vehicles: int,
    avg_speed: float,
    density: str,
    weather: str,
    road_condition: str
) -> dict:

    # =========================================================
    # 1. INPUT VALIDATION
    # =========================================================

    if vehicles < 0:
        raise ValueError("Vehicle count cannot be negative.")

    if avg_speed < 0:
        raise ValueError("Average speed cannot be negative.")

    # Clean input values
    density = str(density or "Low").strip().lower()
    weather = str(weather or "Clear").strip().lower()
    road_condition = str(road_condition or "Dry").strip().lower()

    # =========================================================
    # 2. TRAFFIC LEVEL
    # =========================================================
    #
    # Density is the PRIMARY traffic indicator.
    #
    # Low    -> LOW
    # Medium -> MEDIUM
    # High   -> HIGH
    #
    # Speed is used as a supporting factor.
    # Vehicle count alone will NOT make traffic HIGH.
    # =========================================================

    if density == "high":
        level = "HIGH"

    elif density == "medium":
        level = "MEDIUM"

    else:
        level = "LOW"

    # Very low speed indicates serious congestion.
    if avg_speed < 20:
        level = "HIGH"

    # Low speed on an otherwise low-density road
    # indicates moderate traffic.
    elif avg_speed < 35 and level == "LOW":
        level = "MEDIUM"

    # Extremely high vehicle count can increase
    # a MEDIUM condition to HIGH.
    elif vehicles >= 500 and level == "MEDIUM":
        level = "HIGH"

    # =========================================================
    # 3. WEATHER ANALYSIS
    # =========================================================

    bad_weather = weather in (
        "rain",
        "fog",
        "storm",
        "snow"
    )

    # =========================================================
    # 4. ROAD ANALYSIS
    # =========================================================

    bad_road = road_condition in (
        "damaged",
        "under construction"
    )

    wet_road = road_condition in (
        "wet",
        "damp"
    )

    # =========================================================
    # 5. CONDITION DESCRIPTION
    # =========================================================

    condition_parts = []

    if level == "HIGH":
        condition_parts.append(
            "Severe congestion detected"
        )

    elif level == "MEDIUM":
        condition_parts.append(
            "Moderate traffic flow"
        )

    else:
        condition_parts.append(
            "Traffic flowing smoothly"
        )

    # Weather information
    if bad_weather:
        condition_parts.append(
            f"reduced visibility/traction due to {weather}"
        )

    # Road information
    if bad_road:
        condition_parts.append(
            f"{road_condition} road condition"
        )

    elif wet_road:
        condition_parts.append(
            "wet road surface"
        )

    condition = "; ".join(condition_parts) + "."

    # =========================================================
    # 6. ALERT GENERATION
    # =========================================================

    if level == "HIGH" and bad_weather:

        alert = (
            "High Congestion + Adverse Weather Alert — "
            "exercise added caution."
        )

    elif level == "HIGH":

        alert = (
            "High Congestion Alert — "
            "increased monitoring recommended."
        )

    elif level == "MEDIUM" and (
        bad_weather or wet_road
    ):

        alert = (
            "Moderate Traffic + Unfavorable Conditions Alert — "
            "drive with caution."
        )

    elif bad_weather:

        alert = (
            "Adverse Weather Alert — "
            "drive carefully and maintain safe distance."
        )

    elif bad_road:

        alert = (
            "Road Condition Alert — "
            "consider an alternative route if available."
        )

    else:

        alert = "No major traffic alert."

    # =========================================================
    # 7. RETURN RESULT
    # =========================================================

    return {
        "level": level.upper(),
        "avg_speed": avg_speed,
        "vehicles": vehicles,
        "density": density.title(),
        "weather": weather.title(),
        "road_condition": road_condition.title(),
        "condition": condition,
        "alert": alert,
    }


